{
  "mcpServers": {
    "apollo": {
      "type": "http",
      "url": "https://mcp.apollo.io/mcp"
    },
    "firecrawl": {
      "type": "http",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.firecrawl_api_key}"
      }
    },
    "instantly": {
      "type": "http",
      "url": "https://mcp.instantly.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.instantly_api_key}"
      }
    }
  }
}
